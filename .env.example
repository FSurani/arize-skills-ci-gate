# ── Arize AX (REQUIRED — the demo targets AX only; no Phoenix fallback) ────────
# Get these from the Arize AX console: Space Settings → API Keys.
ARIZE_API_KEY=your-arize-api-key
ARIZE_SPACE_ID=your-arize-space-id

# ── Anthropic (REQUIRED for harness runs + the LLM judge) ──────────────────────
# The harness runs ~200+ times → pinned to Sonnet for cost.
# The judge runs once per case → Opus for quality.
ANTHROPIC_API_KEY=your-anthropic-api-key

# ── Model pins (override only if the IDs below are retired) ────────────────────
# Harness = Haiku: cheapest for the ~200+ runs, and a weaker model surfaces more
# failure cases (sharper variant/baseline contrast). Judge = Sonnet: one call per
# case, good enough for rubric/pairwise judging at lower cost than Opus.
HARNESS_MODEL=claude-haiku-4-5-20251001
JUDGE_MODEL=claude-sonnet-4-6

# ── Tracing smoke-test toggle ──────────────────────────────────────────────────
# ARIZE_DRY_RUN=true tests the tracing plugin wiring without shipping spans to AX.
ARIZE_DRY_RUN=false
